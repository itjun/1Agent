+    try testing.expect(!hold.update(PromptRedrawHold.at(20), .{ .state = .input, .input_cells = 5, .restored = 5 }));
+    try testing.expectEqual(null, hold.wakeIn(PromptRedrawHold.at(20)));
+}
+
