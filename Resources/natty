#!/bin/sh
# Natty managed command-line launcher
app=/Applications/Natty.app
case "${1-}" in
  --help|-h)
    cat <<'HELP'
natty — 打开 Natty 终端
用法：natty [--working-directory=目录] [-e 程序 参数…]
  在 Natty 窗口中新建终端（Natty 只有一个窗口）
  --working-directory  指定工作目录
  --wait-after-command 命令结束后保留终端
  --version            显示版本
自动化可使用 AppleScript 的 Natty 字典。
HELP
    exit 0 ;;
  --version)
    /usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$app/Contents/Info.plist"
    exit $? ;;
esac
if [ ! -x "$app/Contents/MacOS/Natty" ]; then
  echo '未找到 /Applications/Natty.app' >&2
  exit 1
fi
# A running app acknowledges the request before this process exits, preserving failure status.
"$app/Contents/MacOS/Natty" --handoff-only --working-directory="$PWD" "$@"
result=$?
if [ "$result" -ne 2 ]; then exit "$result"; fi
# No app was running. LaunchServices now starts the actual GUI process.
exec /usr/bin/open -na "$app" --args --working-directory="$PWD" "$@"
