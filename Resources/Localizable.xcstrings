{
  "sourceLanguage" : "en",
  "strings" : {
    "New Window" : {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "New Window"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "新建窗口"}}}},
    "Close Window" : {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Close Window"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "关闭窗口"}}}},
    "Close this window and its running sessions?" : {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Close this window and its running sessions?"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "关闭此窗口及其运行中的会话？"}}}},
    "Only sessions in this window will be stopped. Other windows stay open." : {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Only sessions in this window will be stopped. Other windows stay open."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "仅停止此窗口中的会话，其他窗口继续运行。"}}}},
    "Finder services create new terminals and independent windows." : {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Finder services create new terminals and independent windows."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "Finder 服务可新建终端和独立窗口。"}}}},
    "Select a file or folder in Finder, then open the Services menu.\n\nNew 1Agent Tab Here always creates a new terminal in the selected folder, or a file’s parent folder.\n\nNew 1Agent Window Here creates an independent window. Multiple folders share that new window." : {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Select a file or folder in Finder, then open the Services menu.\n\nNew 1Agent Tab Here always creates a new terminal in the selected folder, or a file’s parent folder.\n\nNew 1Agent Window Here creates an independent window. Multiple folders share that new window."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "在 Finder 中选择文件或文件夹，然后打开“服务”菜单。\n\n“在此新建 1Agent 标签”会在所选目录中新建终端；选中文件时，使用其所在目录。\n\n“在此新建 1Agent 窗口”会创建独立窗口；多选目录时，共用该新窗口。"}}}},
    "System Integration" : {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "System Integration"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "系统集成"}}}},
    "Terminal Entries" : {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Terminal Entries"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "终端入口"}}}},
    "Choose what opens with 1Agent." : {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Choose what opens with 1Agent."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "选择由 1Agent 打开的内容。"}}}},
    "Default Terminal" : {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Default Terminal"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "默认终端"}}}},
    "1Agent Is the Default Terminal" : {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "1Agent Is the Default Terminal"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "1Agent 已是默认终端"}}}},
    "Not Set to 1Agent" : {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Not Set to 1Agent"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "尚未设为 1Agent"}}}},
    "Set as Default Terminal" : {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Set as Default Terminal"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "设为默认终端"}}}},
    "Unix executables currently open with %@." : {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Unix executables currently open with %@."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "当前可执行文件由 %@ 打开。"}}}},
    "Opens Unix executables. Other scripts can be selected below." : {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Opens Unix executables. Other scripts can be selected below."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "用于打开 Unix 可执行文件，其他脚本可在下方单独选择。"}}}},
    "Entry" : {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Entry"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "入口"}}}},
    "Current Application" : {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Current Application"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "当前应用"}}}},
    "Open with 1Agent" : {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Open with 1Agent"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "交给 1Agent"}}}},
    "Unix Executables" : {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Unix Executables"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "Unix 可执行文件"}}}},
    ".command Scripts" : {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": ".command Scripts"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": ".command 脚本"}}}},
    ".sh Scripts" : {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": ".sh Scripts"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": ".sh 脚本"}}}},
    ".zsh Scripts" : {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": ".zsh Scripts"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": ".zsh 脚本"}}}},
    "Other Script Types" : {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Other Script Types"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "其他脚本类型"}}}},
    "No Default Application" : {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "No Default Application"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "未检测到默认应用"}}}},
    "Folders keep opening in Finder. Configure .sh and .zsh separately if needed." : {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Folders keep opening in Finder. Configure .sh and .zsh separately if needed."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "文件夹仍由 Finder 打开，.sh 与 .zsh 可按需单独设置。"}}}},
    "Apply Selected Associations" : {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Apply Selected Associations"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "应用所选关联"}}}},
    "Restore Previous Associations" : {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Restore Previous Associations"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "恢复原有关联"}}}},
    "Waiting for macOS to confirm the associations…" : {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Waiting for macOS to confirm the associations…"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "正在等待 macOS 确认关联…"}}}},
    "Finder Directory Services" : {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Finder Directory Services"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "Finder 目录服务"}}}},
    "About Services" : {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "About Services"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "查看服务"}}}},
    "About Finder Services" : {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "About Finder Services"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "查看服务说明"}}}},
    "This file type is unavailable on this Mac." : {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "This file type is unavailable on this Mac."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "此 Mac 不支持该文件类型。"}}}},
    "The current application could not be determined, so its association was left unchanged." : {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "The current application could not be determined, so its association was left unchanged."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法确定当前打开应用，因此保留原有关联。"}}}},
    "The original application “%@” is no longer installed. Its backup has been kept." : {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "The original application “%@” is no longer installed. Its backup has been kept."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "原应用“%@”已不在本机，已保留关联备份。"}}}},
    "macOS did not confirm the new default application. Its backup has been kept." : {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "macOS did not confirm the new default application. Its backup has been kept."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "macOS 未确认新的默认应用，已保留关联备份。"}}}},
    "The saved association backup could not be read. No associations have been changed." : {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "The saved association backup could not be read. No associations have been changed."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法读取已保存的关联备份，尚未更改任何关联。"}}}},
    "macOS could not change this association (error %lld)." : {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "macOS could not change this association (error %lld)."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "macOS 无法更改此关联（错误 %lld）。"}}}},
    "The previous default applications have been restored." : {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "The previous default applications have been restored."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "已恢复更改前的默认打开应用。"}}}},
    "The selected associations have been changed and verified." : {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "The selected associations have been changed and verified."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "已更改所选关联，并完成状态核对。"}}}},
    "These entries already open with 1Agent." : {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "These entries already open with 1Agent."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "这些入口已由 1Agent 打开。"}}}},
    "Some associations were changed. The following entries still need attention:" : {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Some associations were changed. The following entries still need attention:"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "部分关联已更改，以下入口仍需处理："}}}},
    "The operation could not be completed:" : {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "The operation could not be completed:"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "未能完成本次操作："}}}},
    "The change was canceled." : {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "The change was canceled."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "已取消更改。"}}}},
    "Agent conversation recovery needs Python 3.9 or later and Bash or Zsh on this host.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Agent conversation recovery needs Python 3.9 or later and Bash or Zsh on this host."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "此主机需要 Python 3.9 或更新版本以及 Bash 或 Zsh，才能恢复 Agent 对话。"}}}},
    "Cannot restore the Agent conversation. Check the tool, session file and directory.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Cannot restore the Agent conversation. Check the tool, session file and directory."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法恢复 Agent 对话，请检查工具、会话文件和工作目录。"}}}},
    "Macaron Alternatives" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Macaron Alternatives"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"马卡龙备选"}}}},
    "White background, blue icon" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"White background, blue icon"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"白色底板，蓝色图案"}}}},
    "Original Blue" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Original Blue"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"原版蓝色"}}}},
    "Choose an app icon. Finder, the Dock and the app switcher update together, and your choice is remembered after restarting." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose an app icon. Finder, the Dock and the app switcher update together, and your choice is remembered after restarting."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择应用图标，Finder、Dock 与应用切换器中的图标会同步更新，并在下次启动时保留。"}}}},
    "Your saved icon is reapplied when 1Agent starts, including after updating or reinstalling the app." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Your saved icon is reapplied when 1Agent starts, including after updating or reinstalling the app."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"1Agent 启动时会恢复已保存的图标，更新或重新安装后也会自动同步。"}}}},
    "The Finder icon couldn’t be updated. Make sure the app is writable, then select the icon again to retry." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The Finder icon couldn’t be updated. Make sure the app is writable, then select the icon again to retry."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法更新 Finder 图标。请确认应用可写，然后重新选择图标重试。"}}}},
    "App Icon" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"App Icon"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"应用图标"}}}},
    "Default Icon" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Default Icon"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"默认"}}}},
    "Restore Default Icon" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Restore Default Icon"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"恢复默认图标"}}}},
    "The selected app icon couldn’t be loaded. Your previous choice has been kept." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The selected app icon couldn’t be loaded. Your previous choice has been kept."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法加载所选应用图标，已保留之前的选择。"}}}},
