        "en" : { "stringUnit" : { "state" : "translated", "value" : "Drag the title onto a pane edge to combine. Drag it back to the workspace sidebar to separate. Right-click to manage panels and workspace membership or copy host info. Drag the blank part of the bar to move the window." } },
