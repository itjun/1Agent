    "Enter an alias and a command up to 64 KiB. Terminal control characters are not allowed." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Enter an alias and a command up to 64 KiB. Terminal control characters are not allowed."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "请填写别名和命令（最多 64 KiB），命令不能包含终端控制字符。"}}}},
    "Choose a valid SSH host." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Choose a valid SSH host."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "请选择有效的 SSH 主机。"}}}},
    "Choose an available absolute working directory." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Choose an available absolute working directory."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "请选择可访问的工作目录，使用绝对路径。"}}}},
    "The command library is invalid. Existing commands were not changed." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The command library is invalid. Existing commands were not changed."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "指令库格式无效，现有指令未被修改。"}}}},
    "This command library version is not supported." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "This command library version is not supported."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "暂不支持这个版本的指令库。"}}}},
    "The terminal or its directory changed. Close this dialog and confirm again." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The terminal or its directory changed. Close this dialog and confirm again."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "终端或目录已变化，请关闭此弹窗后重新确认。"}}}},
    "The terminal cannot accept this command. Open the confirmation again to use a new terminal." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The terminal cannot accept this command. Open the confirmation again to use a new terminal."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "当前终端无法接收命令，请重新打开确认框并选择新终端。"}}}},
    "Execution was not acknowledged. Check the terminal before running again; this request will not be retried." : {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Execution was not acknowledged. Check the terminal before running again; this request will not be retried."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "未收到执行回执，请先检查终端再决定是否重试；本次请求不会自动重发。"}}}},
