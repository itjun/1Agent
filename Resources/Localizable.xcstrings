        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "仅对本机 zsh 生效，修改后新打开的终端才会加载。其他 shell 与 SSH 远程会话不加载。两项 SSH 功能需要 Ghostty 命令行工具，这里不会启用。" } }
      }
