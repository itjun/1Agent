          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在主机上执行：gooseagent plugin action invoke gooseagent.tailcat.token — 令牌存储在本设备的钥匙串中，隧道无需 SSH。"
