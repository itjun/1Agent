# Loaded only by this SSH terminal's private rc file.
if [[ -z $ONEAGENT_AGENT_HELPER || ! -x $ONEAGENT_AGENT_HELPER || -n $ONEAGENT_AGENT_INVOCATION ]]; then return 0; fi
_oneagent_agent_run() {
    local agent=$1 executable
    shift
    if [[ -n $ONEAGENT_AGENT_INVOCATION ]]; then command "$agent" "$@"; return $?; fi
    executable=$(type -P "$agent")
    if [[ -z $executable ]]; then command "$agent" "$@"; return $?; fi
    "$ONEAGENT_AGENT_HELPER" run "$agent" "$executable" "$@"
}
for _oneagent_agent_name in grok pi omp codex claude; do
    if ! declare -F "$_oneagent_agent_name" >/dev/null; then
        eval "function $_oneagent_agent_name { _oneagent_agent_run $_oneagent_agent_name \"\$@\"; }"
    fi
done
unset _oneagent_agent_name
_oneagent_report_cwd() { printf '\033]7;kitty-shell-cwd://%s%s\007' "${HOSTNAME:-remote}" "$PWD"; }
if [[ $(declare -p PROMPT_COMMAND 2>/dev/null) == 'declare -a '* ]]; then
    PROMPT_COMMAND+=(_oneagent_report_cwd)
else
    PROMPT_COMMAND="${PROMPT_COMMAND:+$PROMPT_COMMAND; }_oneagent_report_cwd"
fi
